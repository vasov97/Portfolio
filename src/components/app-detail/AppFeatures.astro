---
import TechChip from '../stack/TechChip.astro';
import { STACK, type TechItem } from '../../data/stack';
import type { App } from '../../lib/apps';
import { useTranslations, type Locale } from '../../i18n/utils';

interface Props {
  app: App;
  locale: Locale;
}

const { app, locale } = Astro.props;
const t = useTranslations(locale);
const features = app.data.features?.[locale] ?? [];

// Reuse logos from the tech stack when the names match
const allTech = STACK.flatMap((g) => g.items);
const tech: TechItem[] = app.data.tech.map(
  (name) => allTech.find((i) => i.name.toLowerCase() === name.toLowerCase()) ?? { name },
);
---

{
  (features.length > 0 || tech.length > 0) && (
    <section class="section">
      <div class="container grid">
        {features.length > 0 && (
          <div>
            <h2>{t('appDetail.features')}</h2>
            <ul class="features">
              {features.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
          </div>
        )}

        {tech.length > 0 && (
          <div>
            <h2>{t('appDetail.tech')}</h2>
            <ul class="tech">
              {tech.map((item) => (
                <TechChip item={item} />
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-8);
  }
  h2 {
    margin-bottom: var(--space-5);
    font-size: var(--fs-h3);
  }
  .features {
    display: flex;
    flex-direction: column;
    list-style: none;
  }
  .features li {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-top: 1px solid var(--border);
    font-size: var(--fs-lg);
  }
  .features li:last-child {
    border-bottom: 1px solid var(--border);
  }
  .features li::before {
    content: '';
    width: 8px;
    height: 8px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--accent-gradient);
  }
  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
  }
</style>