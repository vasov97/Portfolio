---
import Button from '../ui/Button.astro';
import { SITE } from '../../config/site';
import { localizePath, useTranslations, type Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const estimateHref = `${localizePath('', locale)}#estimate`;
---

<section class="section">
  <div class="container">
    <div class="cta">
      <h2>{t('appDetail.ctaTitle')}</h2>
      <p>{t('appDetail.ctaText')}</p>
      <div class="actions">
        <Button href={SITE.calendly} external size="lg" dot>{t('common.cta.bookCall')}</Button>
        <Button href={estimateHref} variant="ghost" size="lg">{t('appDetail.ctaEstimate')}</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-9) var(--space-6);
    text-align: center;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(70% 80% at 50% 100%, var(--glow), transparent 70%),
      var(--surface);
  }
  h2 {
    font-size: var(--fs-h1);
  }
  p {
    max-width: 560px;
    font-size: var(--fs-lg);
    color: var(--text-muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
</style>