---
interface Props {
  src?: string;
  size?: number;
}

const { src, size = 48 } = Astro.props;
---

{
  src && (
    <img
      src={src}
      alt=""
      width={size}
      height={size}
      loading="lazy"
      decoding="async"
      class="app-icon"
      style={`--size: ${size}px`}
    />
  )
}

<style>
  .app-icon {
    width: var(--size);
    height: var(--size);
    flex-shrink: 0;
    object-fit: cover;
    border-radius: 22%;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08),
      0 8px 24px rgba(0, 0, 0, 0.35);
  }
</style>