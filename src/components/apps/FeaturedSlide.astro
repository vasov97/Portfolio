---
import AppCover from './AppCover.astro';
import AppIcon from './AppIcon.astro';
import StoreLinks from './StoreLinks.astro';
import Icon from '../ui/Icon.astro';
import { loc, type App } from '../../lib/apps';
import { localizePath, useTranslations, type Locale } from '../../i18n/utils';

interface Props {
  app: App;
  locale: Locale;
  index: number;
  total: number;
}

const { app, locale, index, total } = Astro.props;
const t = useTranslations(locale);
const d = app.data;
const href = localizePath(`apps/${app.id}`, locale);
---

<article
  class="slide"
  style={`--app-color: ${d.color}`}
  aria-roledescription="slide"
  aria-label={`${index + 1} / ${total}: ${d.name}`}
  data-slide
>
  <a href={href} class="card">
    <div class="card-inner">
      <div class="card-head">
        <div class="title">
          <AppIcon src={d.icon} size={56} />
          <div>
            <h3>{d.name}</h3>
            <p>{loc(d.tagline, locale)}</p>
          </div>
        </div>
        <span class="arrow"><Icon name="arrow-up-right" size={18} /></span>
      </div>

      <div class="cover">
        <AppCover app={app} alt={`${d.name} — ${t('apps.screenshotAlt')}`} eager={index === 0} />
      </div>

      <span class="chip">{loc(d.category, locale)}</span>
    </div>
  </a>

  <div class="details">
    <p class="summary">{loc(d.summary, locale)}</p>

    <dl class="stats">
      {
        d.stats.map((s) => (
          <div class="stat">
            <dt>{loc(s.value, locale)}</dt>
            <dd>{loc(s.label, locale)}</dd>
          </div>
        ))
      }
    </dl>

    <StoreLinks links={d.links} locale={locale} />
  </div>
</article>

<style>
  .slide {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-8);
    scroll-snap-align: start;
  }

  /* ---------- Card with cut corner ---------- */
  .card {
    --cut: 36px;
    display: block;
    padding: 1px;
    background: var(--border-strong);
    clip-path: polygon(
      0 0,
      100% 0,
      100% calc(100% - var(--cut)),
      calc(100% - var(--cut)) 100%,
      0 100%
    );
    border-radius: var(--radius-lg) var(--radius-lg) 0 var(--radius-lg);
  }
  .card-inner {
    position: relative;
    height: 540px;
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    overflow: hidden;
    background:
      radial-gradient(
        120% 70% at 50% 100%,
        color-mix(in srgb, var(--app-color) 75%, transparent) 0%,
        transparent 70%
      ),
      #07090c;
    clip-path: polygon(
      0 0,
      100% 0,
      100% calc(100% - var(--cut) + 0.5px),
      calc(100% - var(--cut) + 0.5px) 100%,
      0 100%
    );
    border-radius: calc(var(--radius-lg) - 1px) calc(var(--radius-lg) - 1px) 0
      calc(var(--radius-lg) - 1px);
  }

  .card-head {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .title {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .card-head h3 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }
  .card-head p {
    margin-top: var(--space-1);
    color: var(--text-muted);
  }
  .arrow {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    transition: background-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .card:hover .arrow {
    background: var(--text);
    color: #000;
    transform: rotate(45deg);
  }

  .cover {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -40px;
    height: 68%;
    display: flex;
    justify-content: center;
    transition: transform 0.6s var(--ease);
  }
  .card:hover .cover {
    transform: translateY(-12px);
  }

  .chip {
    position: absolute;
    left: var(--space-6);
    bottom: var(--space-6);
    z-index: 1;
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-sm);
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(8px);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  /* ---------- Details ---------- */
  .details {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .summary {
    font-size: var(--fs-lg);
    color: var(--text-muted);
  }
  .stats {
    display: flex;
    flex-direction: column;
  }
  .stat {
    display: grid;
    grid-template-columns: minmax(140px, 0.9fr) 1.1fr;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-top: 1px solid var(--border);
  }
  .stat dt {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    line-height: 1.1;
  }
  .stat dd {
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .slide {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .card-inner {
      height: 460px;
    }
    .stat {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>