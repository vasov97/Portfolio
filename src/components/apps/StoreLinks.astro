---
import Icon, { type IconName } from '../ui/Icon.astro';
import { useTranslations, type Locale } from '../../i18n/utils';

interface Props {
  links: { appStore?: string; googlePlay?: string; website?: string };
  locale: Locale;
}

type Item = { href: string; icon: IconName; label: string };

const { links, locale } = Astro.props;
const t = useTranslations(locale);

const items: Item[] = [];
if (links.appStore) items.push({ href: links.appStore, icon: 'apple', label: t('apps.appStore') });
if (links.googlePlay)
  items.push({ href: links.googlePlay, icon: 'google-play', label: t('apps.googlePlay') });
if (links.website) items.push({ href: links.website, icon: 'globe', label: t('apps.website') });
---

{
  items.length > 0 && (
    <div class="stores">
      <span class="label">{t('apps.availableOn')}</span>
      <ul>
        {items.map((i) => (
          <li>
            <a href={i.href} target="_blank" rel="noopener noreferrer">
              <Icon name={i.icon} size={16} />
              {i.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .stores {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
  .label {
    font-size: var(--fs-sm);
    color: var(--text-dim);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }
  a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    font-size: var(--fs-sm);
    color: var(--text-muted);
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  a:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }
</style>